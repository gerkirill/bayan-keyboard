[Connections]
InEnabled=false
ThruEnabled=false
InputDriver=ALSA
OutputDriver=ALSA
OutPort=FLUID Synth (Bayan) (1)

[Keyboard]
RawKeyboardMode=false
MapFile=@MAP_FILE@

[Preferences]
BaseOctave=4
Transpose=0
Channel=0
Velocity=85
NumKeys=61
StartingKey=0
InstrumentsDefinition=@INSTRUMENTS@
InstrumentName=General MIDI
EnableKeyboardInput=true
EnforceChannelState=true
ShowStatusBar=true

[FluidSynth]
AudioDriver=pipewire
InstrumentsDefinition=@SOUNDFONT@
SampleRate=48000
PeriodSize=128
Periods=2
Gain=0.2
Chorus=1
Reverb=1

[Instrument0]
Bank=0
Program=21
Controller=1

[Shortcuts]
actionChannelDown=
actionChannelUp=
actionContents=Ctrl+F1
actionControllerDown=Alt+-
actionControllerUp=Alt++
actionNextBank=Ctrl+PgUp
actionNextController=Ctrl++
actionNextProgram=PgUp
actionOctaveDown=
actionOctaveUp=
actionPanic=Esc
actionPreviousBank=Ctrl+PgDown
actionPreviousController=Ctrl+-
actionPreviousProgram=PgDown
actionTransposeDown=
actionTransposeUp=
actionVelocityDown=Home
actionVelocityUp=End
